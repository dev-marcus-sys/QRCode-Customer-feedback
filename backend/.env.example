# =============================================================
# QRCode 客戶意見反饋 — 環境變數範本
# 複製本檔為 backend/.env 後依環境調整。
# 注意：.env 含 JWT_SECRET 等機密，.gitignore 已忽略，請勿提交至 Git。
# 完整說明見 部署說明_測試環境.md §3 / README.md「環境變數」。
# =============================================================

# ---------- 測試機（smsdev01 / 11.0.11.211）推薦值 ----------
# 直接複製以下區塊即可重現測試機設定（JWT_SECRET 請另填隨機長字串）：
# PORT=3100
# APP_ENV=test
# DB_PATH=./data/qr_feedback.sqlite
# APP_TZ=Asia/Hong_Kong
# JWT_SECRET=<請更換為隨機長字串，例如 openssl rand -hex 32>
# DEFAULT_LANG=zh-Hant
# EMAIL_SCAN_INTERVAL_MS=15000
# SMTP_HOST=11.0.1.130
# SMTP_PORT=25
# MAIL_FROM=sysalert@synergis.com.hk

# ---------- 通用 / 本機預設 ----------
PORT=3000
# SQLite 檔案路徑（相對 backend 啟動目錄）。
# 測試機 / 本機均建議用檔案庫以保留資料；:memory: 僅供 CI / 單元測試，重啟即清空。
DB_PATH=./data/qr_feedback.sqlite
# JWT 密鑰（投產 / 測試機必須更換為隨機長字串，切勿沿用開發預設值）
JWT_SECRET=qr-feedback-dev-secret-change-me
# JWT 有效時長（分鐘）
JWT_EXPIRES_MINUTES=120
# 預設語系
DEFAULT_LANG=zh-Hant
# 時區（DB 內存 UTC，對外以此外輸出）
APP_TZ=Asia/Hong_Kong
# 執行環境標籤：local（本機開發 / localhost）｜ test（測試環境）｜ production（正式環境 / 真實環境）
# 前端頁面底部會顯示此標籤與資料庫位置；health 亦回傳 environment。省略時依 NODE_ENV 推斷（非 production 視為本機）。
APP_ENV=local
# ---- M0 AI（AI-01 內容分類；見 docs/AI_利用方案.md §6.3）----
# 用邊個供應商由「系統參數 → AI 參數 → ai.provider」決定（none/rules/openai/ollama）。
# 選 rules（內建規則基線）時以下三項唔需要；選 openai/ollama 先會用到。
# AI_BASE_URL  省略時：openai → https://api.openai.com/v1；ollama → http://localhost:11434
# AI_API_KEY   openai 必填（缺會報 "AI_API_KEY 未設定"）；ollama 可省略
# AI_MODEL     省略時：openai → gpt-4o-mini；ollama → qwen2.5:7b
# 注意：金鑰只放環境變數，唔會寫入資料庫／審計／前端；改動後需重啟後端。
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=
# AI_MODEL=gpt-4o-mini
# 遠端分類佇列掃描間隔（毫秒；省略=60000；設 0 停用）。rules 為建案即時處理，不受此值影響。
# AI_SCAN_INTERVAL_MS=60000

# ---- 郵件 SMTP（個案管理系統通知 / 問卷 / 週報經此 relay 實際寄出）----
# 內部 relay 範例：SMTP_HOST=11.0.1.130 / SMTP_PORT=25（明文、無 TLS、通常無帳密）
SMTP_HOST=
SMTP_PORT=25
SMTP_USER=
SMTP_PASS=
MAIL_FROM=sysalert@synergis.com.hk
# 郵件佇列掃描間隔（毫秒；省略=15000；設 0 停用）。0 時信件只入庫不寄出。
EMAIL_SCAN_INTERVAL_MS=15000
