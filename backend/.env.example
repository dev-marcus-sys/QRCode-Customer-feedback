# 複製為 .env 並依本機環境調整
PORT=3000
# 本機資料庫路徑；測試以 DB_PATH=:memory: 執行
DB_PATH=./data/qr_feedback.sqlite
# Demo 用 JWT 密鑰（投產必須更換並外置）
JWT_SECRET=qr-feedback-dev-secret-change-me
# JWT 有效時長（分鐘）
JWT_EXPIRES_MINUTES=120
# 預設語系
DEFAULT_LANG=zh-Hant
# 時區（本骨架固定 UTC+8 對外輸出，此值保留作參數化預留）
APP_TZ=Asia/Hong_Kong
# ---- M0 AI（AI-01 內容分類；見 docs/AI_利用方案.md §6.3）----
# 用邊個供應商由「系統參數 → AI 參數 → ai.provider」決定（none/rules/openai/ollama）。
# 選 rules（內建規則基線）時以下三項唔需要；選 openai/ollama 先會用到。
# AI_BASE_URL  省略時：openai → https://api.openai.com/v1；ollama → http://localhost:11434
# AI_API_KEY   openai 必填（缺會報 "AI_API_KEY 未設定"）；ollama 可省略
# AI_MODEL     省略時：openai → gpt-4o-mini；ollama → qwen2.5:7b
# 注意：金鑰只放環境變數，唔會寫入資料庫／審計／前端；改動後需重啟後端。
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=
# AI_MODEL=gpt-4o-mini
# 遠端分類佇列掃描間隔（毫秒；省略=60000；設 0 停用）。rules 為建案即時處理，不受此值影響。
# AI_SCAN_INTERVAL_MS=60000
